POSTGRES_DB=flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433

SQLALCHEMY_DATABASE_URL=postgresql+psycopg://appuser:apppass@postgres:5432/flowdesk

JWT_SECRET_KEY=change-me-with-a-long-random-value
NGINX_PORT=80

# En producción, usa una lista JSON con los dominios autorizados.
# Ejemplo: ["https://flowdesk-preview.vercel.app","https://flowdesk.armsystem.com.mx"]
CORS_ORIGINS=["http://localhost","http://localhost:4200"]
FRONTEND_URL=http://localhost

# Correo transaccional. `development` no envía mensajes y muestra los enlaces
# únicamente en los logs del backend.
EMAIL_PROVIDER=development
EMAIL_FROM_ADDRESS=no-reply@flowdesk.local
EMAIL_FROM_NAME=Flowdesk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

#Credenciales del superadmin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=<contraseña-segura>
